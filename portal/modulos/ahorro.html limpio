<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Ahorro — Mi Banco</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
  <link href="../css/styles.css" rel="stylesheet">
</head>
<body>

<!-- Toast -->
<div class="toast-container position-fixed bottom-0 end-0 p-3">
  <div id="appToast" class="toast align-items-center text-white bg-success border-0">
    <div class="d-flex">
      <div class="toast-body" id="toastBody">OK</div>
      <button class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
    </div>
  </div>
</div>

<!-- Navbar -->
<nav class="navbar navbar-expand-lg navbar-banco">
  <div class="container-fluid px-4">
    <a class="navbar-brand" href="dashboard.html"><i class="bi bi-bank me-2"></i>MI BANCO</a>
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
      <span class="navbar-toggler-icon"></span>
    </button>
    <div class="collapse navbar-collapse" id="navbarNav">
      <ul class="navbar-nav ms-auto align-items-center gap-2">
        <li class="nav-item">
          <span class="nav-link" style="color:var(--color-acento);font-weight:600">
            <i class="bi bi-person-circle me-1"></i><span id="userName">Cliente</span>
          </span>
        </li>
        <li><button class="btn btn-sm btn-outline-light" id="btnLogout">
          <i class="bi bi-box-arrow-right me-1"></i>Cerrar sesión
        </button></li>
      </ul>
    </div>
  </div>
</nav>

<div class="portal-layout">
  <nav class="sidebar d-none d-lg-block">
    <ul class="nav flex-column">
      <li><a class="nav-link" href="dashboard.html"><i class="bi bi-grid-1x2"></i> Dashboard</a></li>
      <li><a class="nav-link" href="transacciones.html"><i class="bi bi-arrow-left-right"></i> Transacciones</a></li>
      <li><a class="nav-link" href="pagos.html"><i class="bi bi-credit-card"></i> Pagos</a></li>
      <li><a class="nav-link" href="prestamos.html"><i class="bi bi-cash-stack"></i> Préstamos</a></li>
      <li><a class="nav-link active" href="ahorro.html"><i class="bi bi-piggy-bank"></i> Ahorro</a></li>
    </ul>
  </nav>

  <main class="main-content">
    <h4 class="fw-bold mb-1"><i class="bi bi-piggy-bank me-2 text-success"></i>Cuenta de Ahorro</h4>
    <p class="text-muted small mb-4">Seguimiento de tu ahorro y metas financieras</p>

    <!-- Spinner carga -->
    <div id="loadingAhorro" class="text-center py-5">
      <div class="spinner-border text-success"></div>
      <p class="text-muted mt-2">Cargando cuenta de ahorro...</p>
    </div>

    <!-- Contenido (oculto hasta cargar) -->
    <div id="contenidoAhorro" class="d-none">

      <!-- Tarjeta principal -->
      <div class="row g-4 mb-4">
        <div class="col-12 col-md-6">
          <div class="card border-0 shadow-sm" style="border-left:5px solid #198754 !important; border-radius:12px">
            <div class="card-body p-4">
              <div class="d-flex justify-content-between align-items-start mb-3">
                <div>
                  <span class="badge bg-success mb-2">Cuenta de Ahorro</span>
                  <div class="text-muted small" id="numCuentaAhorro">••• ••• ••••</div>
                </div>
                <i class="bi bi-piggy-bank text-success" style="font-size:2rem"></i>
              </div>
              <div class="monto text-success mb-1" id="saldoAhorro">S/ —</div>
              <div class="text-muted small">Saldo disponible · PEN</div>
            </div>
          </div>
        </div>

        <div class="col-12 col-md-6">
          <div class="row g-3">
            <div class="col-6">
              <div class="card border-0 bg-light text-center p-3">
                <div class="text-muted small">Tasa anual</div>
                <div class="fw-bold fs-4 text-success" id="tasaAhorro">—</div>
              </div>
            </div>
            <div class="col-6">
              <div class="card border-0 bg-light text-center p-3">
                <div class="text-muted small">Fecha apertura</div>
                <div class="fw-bold" id="fechaApertura">—</div>
              </div>
            </div>
            <div class="col-12">
              <div class="card border-0 bg-light text-center p-3">
                <div class="text-muted small">Meta de ahorro</div>
                <div class="fw-bold fs-5 text-primary" id="metaAhorro">—</div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Barra de progreso de meta -->
      <div class="card border-0 shadow-sm mb-4">
        <div class="card-body">
          <div class="d-flex justify-content-between align-items-center mb-2">
            <div>
              <h6 class="fw-bold mb-0">Progreso hacia tu meta</h6>
              <p class="text-muted small mb-0">
                <span id="saldoProgreso">S/ —</span> de <span id="metaProgreso">S/ —</span>
              </p>
            </div>
            <div class="text-end">
              <div class="fw-bold fs-4 text-success" id="pctProgreso">0%</div>
              <div class="text-muted small" id="faltaProgreso">Falta: —</div>
            </div>
          </div>
          <div class="progress" style="height:20px">
            <div class="progress-bar progress-bar-ahorro progress-bar-striped progress-bar-animated"
                 id="barraProgreso" role="progressbar" style="width:0%">
            </div>
          </div>
          <div class="d-flex justify-content-between mt-1">
            <span class="text-muted" style="font-size:.75rem">S/ 0</span>
            <span class="text-muted small" id="metaLabel">Meta: S/ —</span>
          </div>
        </div>
      </div>

      <!-- Tabs: movimientos / proyección -->
      <div class="card border-0 shadow-sm">
        <div class="card-header bg-white border-0 pt-3 pb-0">
          <ul class="nav nav-tabs border-0" id="tabsAhorro" role="tablist">
            <li class="nav-item">
              <button class="nav-link active fw-semibold" data-bs-toggle="tab" data-bs-target="#tabMovimientos">
                <i class="bi bi-list-ul me-2"></i>Movimientos
              </button>
            </li>
            <li class="nav-item">
              <button class="nav-link fw-semibold" data-bs-toggle="tab" data-bs-target="#tabProyeccion">
                <i class="bi bi-graph-up me-2"></i>Proyección
              </button>
            </li>
          </ul>
        </div>
        <div class="card-body p-0 tab-content">

          <!-- Tab Movimientos -->
          <div class="tab-pane fade show active" id="tabMovimientos">
            <div class="table-responsive">
              <table class="table table-hover mb-0">
                <thead class="table-light">
                  <tr>
                    <th class="ps-3">Fecha</th>
                    <th>Concepto</th>
                    <th>Tipo</th>
                    <th class="text-end pe-3">Monto</th>
                  </tr>
                </thead>
                <tbody id="movAhorro">
                  <tr><td colspan="4" class="text-center py-3 text-muted">Sin movimientos registrados.</td></tr>
                </tbody>
              </table>
            </div>
          </div>

          <!-- Tab Proyección -->
          <div class="tab-pane fade" id="tabProyeccion">
            <div class="p-4">
              <p class="text-muted small mb-3">
                Estimado de crecimiento mensual de tu ahorro con la tasa actual, sin depósitos adicionales.
              </p>
              <div class="table-responsive">
                <table class="table table-sm table-striped">
                  <thead class="table-dark">
                    <tr>
                      <th>Mes</th>
                      <th class="text-end">Saldo estimado</th>
                      <th class="text-end">Interés ganado</th>
                    </tr>
                  </thead>
                  <tbody id="tablaProyeccion"></tbody>
                </table>
              </div>
            </div>
          </div>

        </div>
      </div>

    </div><!-- /contenidoAhorro -->
  </main>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script type="module" src="../js/ahorro.js"></script>
</body>
</html>
